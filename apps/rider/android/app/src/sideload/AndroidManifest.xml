<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sideload flavor only: install our own update APK (never in the store build). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Shares the downloaded APK (cache/updates/) with the system installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.apkprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/apk_paths" />
        </provider>
    </application>
</manifest>
