# ---- RideMA environment. Copy to .env and fill. Never commit .env. ----

# Server
SERVER_IP=203.0.113.10
SSH_TARGET=root@203.0.113.10
# Public host; leave empty to use ${SERVER_IP}.sslip.io
PUBLIC_HOST=
ACME_EMAIL=ops@example.com
NODE_ENV=production
LOG_LEVEL=info

# Database / cache
POSTGRES_USER=ridema
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=ridema
DATABASE_URL=postgres://ridema:change-me-long-random@postgres:5432/ridema
REDIS_URL=redis://redis:6379
# Optional: if set, also put it in REDIS_URL (redis://:PASSWORD@redis:6379)
REDIS_PASSWORD=

# Auth secrets (generate with: openssl rand -base64 48)
JWT_SECRET=
# 32 bytes base64 (openssl rand -base64 32). Wraps per-document data keys.
DOCUMENT_MASTER_KEY=
# 32 bytes base64. Encrypts TOTP secrets.
TOTP_ENC_KEY=
# First admin account created by the seed (TOTP enrolment forced on first login)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Comma separated CIDRs allowed to reach /admin and /v1/admin (empty = allow all, warning logged)
ADMIN_IP_ALLOWLIST=

# Email (EMAIL_PROVIDER=smtp|log)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RideMA <no-reply@example.com>"

# Phone verification (OTP_CHANNEL=whatsapp|log). SMS slot exists but is disabled.
OTP_CHANNEL=whatsapp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=ridema_otp
# Utility template for SOS alerts to saved emergency contacts (2 body params: first name, live trip link). Empty = log only (D71).
WHATSAPP_SOS_TEMPLATE=
WHATSAPP_API_VERSION=v21.0
SMS_PROVIDER=disabled

# Maps
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
GOOGLE_PLACES_KEY=
# OSRM (self-hosted, Morocco extract). ROUTER_PROVIDER=osrm|haversine
ROUTER_PROVIDER=osrm
OSRM_URL=http://osrm:5000
OSRM_IMAGE=osrm/osrm-backend:v5.25.0
OSM_EXTRACT_URL=https://download.geofabrik.de/africa/morocco-latest.osm.pbf

# Firebase (files are mounted, not inlined)
PUSH_PROVIDER=fcm
FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json
FIREBASE_ANDROID_RIDER_CONFIG=apps/rider/android/app/src/google-services.json
FIREBASE_ANDROID_DRIVER_CONFIG=apps/driver/android/app/src/google-services.json
FIREBASE_IOS_RIDER_CONFIG=apps/rider/ios/Runner/GoogleService-Info.plist
FIREBASE_IOS_DRIVER_CONFIG=apps/driver/ios/Runner/GoogleService-Info.plist

# Play Integrity (driver app)
PLAY_INTEGRITY_PROJECT_NUMBER=
PLAY_INTEGRITY_SERVICE_ACCOUNT_FILE=

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
ALERT_WEBHOOK_URL=

# Document storage (S3 compatible). STORAGE_PROVIDER=s3|local
STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Backups (WAL-G, S3 compatible, a DIFFERENT provider than object storage)
BACKUP_STORAGE_ENDPOINT=
BACKUP_STORAGE_REGION=
BACKUP_STORAGE_BUCKET=
BACKUP_STORAGE_ACCESS_KEY=
BACKUP_STORAGE_SECRET_KEY=
# openssl rand -base64 32 ; encrypts backups client-side (libsodium)
BACKUP_ENCRYPTION_KEY=
# Optional backup tuning
BACKUP_TIME=03:00
BACKUP_RETAIN_FULL=7
BACKUP_PREFIX=ridema

# TURN for in-app voice calls
TURN_SECRET=
TURN_REALM=ridema
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Android signing
ANDROID_KEYSTORE=secrets/ridema-release.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=ridema
ANDROID_KEY_PASSWORD=
