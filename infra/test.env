# DUMMY values for `docker compose config` and the local backup/restore test. Not secrets.
# Paths are relative to infra/ (compose file dir).
RIDEMA_ENV_FILE=test.env
SERVER_IP=203.0.113.10
SSH_TARGET=root@203.0.113.10
PUBLIC_HOST=
ACME_EMAIL=ops@example.com
NODE_ENV=production
LOG_LEVEL=info
POSTGRES_USER=ridema
POSTGRES_PASSWORD=dummy-local-password
POSTGRES_DB=ridema
DATABASE_URL=postgres://ridema:dummy-local-password@postgres:5432/ridema
REDIS_URL=redis://redis:6379
JWT_SECRET=dummy-jwt-secret-dummy-jwt-secret-dummy
DOCUMENT_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
TOTP_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ADMIN_IP_ALLOWLIST=127.0.0.1/32,10.0.0.0/8
EMAIL_PROVIDER=log
OTP_CHANNEL=log
PUSH_PROVIDER=log
ROUTER_PROVIDER=haversine
OSRM_URL=http://osrm:5000
OSM_EXTRACT_URL=https://download.geofabrik.de/africa/morocco-latest.osm.pbf
STORAGE_PROVIDER=local
BACKUP_STORAGE_ENDPOINT=http://minio:9000
BACKUP_STORAGE_REGION=us-east-1
BACKUP_STORAGE_BUCKET=ridema-backups
BACKUP_STORAGE_ACCESS_KEY=minioadmin
BACKUP_STORAGE_SECRET_KEY=minioadmin-secret
# 32 zero bytes, base64 - test only
BACKUP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
TURN_SECRET=dummy-turn-secret
TURN_REALM=ridema

# Local simulator only: all simulated users share one IP, so relax rate limits.
RATE_LIMIT_MULTIPLIER=50
